{
  "name": "lapstack-desktop",
  "version": "0.1.0",
  "description": "lapstack \u2014 focus stacking in the browser app, packaged as a desktop application",
  "author": {
    "name": "RAGTUX LLC",
    "email": "support@ragtux.com"
  },
  "homepage": "https://lapstack.ragtux.com",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lapstack.desktop",
    "productName": "lapstack",
    "copyright": "Copyright (c) 2026 RAGTUX LLC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!test/**",
          "!dist/**",
          "!test.html",
          "!*.sh",
          "!probe.html",
          "!**/*.d.ts"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
